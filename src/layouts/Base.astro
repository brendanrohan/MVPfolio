---
interface Props {
  title: string;
  screenLabel?: string;
}

const { title, screenLabel } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="wrap" data-screen-label={screenLabel}>
    <slot />
  </div>
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/components.css';
</style>
